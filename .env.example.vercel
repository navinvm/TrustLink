# Vercel Environment Variables
# Add these in Vercel Dashboard > Settings > Environment Variables

# ============================================
# DATABASE (Connect to Railway)
# ============================================
# Get this from Railway > PostgreSQL > Variables > DATABASE_URL
DATABASE_URL=postgresql://user:password@containers-us-west-123.railway.app:5432/railway

# ============================================
# FLASK CONFIGURATION
# ============================================
FLASK_ENV=production
# IMPORTANT: Use the SAME secret key as Railway!
SECRET_KEY=same-secret-key-as-railway-min-32-chars

# ============================================
# SERVERLESS CONFIGURATION
# ============================================
# Disable background training (read-only filesystem)
AUTO_ML_TRAINING=false

# Vercel automatically sets this, but you can add it explicitly
VERCEL=1

# ============================================
# OPTIONAL FEATURES
# ============================================
# AI Chatbot (if using)
# CHATBOT_PROVIDER=huggingface
# HUGGINGFACE_API_KEY=your-hf-key

# ============================================
# SECURITY
# ============================================
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax
