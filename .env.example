# TrustLink Environment Configuration
# Copy this file to .env and fill in your values

# Flask Configuration
FLASK_ENV=production
FLASK_SECRET_KEY=generate-a-secure-random-key-here
FLASK_APP=app.py

# Database Configuration
DATABASE_PATH=/app/data/trustlink.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# Redis Configuration (for caching and sessions)
REDIS_URL=redis://localhost:6379/0

# Celery Configuration (for async tasks)
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Instance Configuration (for distributed deployments)
INSTANCE_ID=web1
INSTANCE_REGION=us-east-1

# Security Configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# Rate Limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_SCAN=1000
RATE_LIMIT_WINDOW=3600
RATE_LIMIT_BATCH=10
RATE_LIMIT_FEEDBACK=20
RATE_LIMIT_RETRAIN=5

# Monitoring
METRICS_ENABLED=true
HEALTH_CHECK_ENABLED=true

# CDN Configuration (optional)
CDN_URL=https://cdn.yourdomain.com
USE_CDN=false

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
EMAIL_FROM=TrustLink <noreply@trustlink.com>

# External APIs (optional)
VIRUSTOTAL_API_KEY=your-virustotal-api-key
GOOGLE_SAFE_BROWSING_API_KEY=your-google-safe-browsing-key

# AI Chatbot Configuration (Optional)
CHATBOT_ENABLED=true
CHATBOT_PROVIDER=huggingface
HUGGINGFACE_API_KEY=
HUGGINGFACE_MODEL=mistralai/Mistral-7B-Instruct-v0.2
OPENAI_API_KEY=your-openai-api-key-here

# Automatic ML Training (Optional - enabled by default)
AUTO_ML_TRAINING=true

# Logging
LOG_LEVEL=INFO
LOG_FILE=/app/logs/trustlink.log

# Performance Tuning
GUNICORN_WORKERS=4
GUNICORN_THREADS=2
GUNICORN_WORKER_CLASS=gthread
GUNICORN_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# Cache Settings
CACHE_DEFAULT_TTL=3600
CACHE_SCAN_TTL=3600
CACHE_WHITELIST_TTL=86400
