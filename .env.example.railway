# Railway Environment Variables
# Copy this to Railway dashboard > Variables tab

# ============================================
# DATABASE (Automatically provided by Railway)
# ============================================
# DATABASE_URL=postgresql://user:pass@host:5432/railway
# ↑ This is auto-set when you add PostgreSQL service

# ============================================
# FLASK CONFIGURATION
# ============================================
FLASK_ENV=production
SECRET_KEY=change-this-to-a-random-secret-key-min-32-chars

# ============================================
# FEATURES
# ============================================
# Enable automatic ML training (Railway has persistent storage)
AUTO_ML_TRAINING=true

# Redis (optional - uncomment if you add Redis service)
# USE_REDIS=true
# REDIS_URL=redis://default:password@host:6379

# ============================================
# OPTIONAL FEATURES
# ============================================
# Email notifications (optional)
# SMTP_SERVER=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM=TrustLink <noreply@trustlink.com>

# AI Chatbot (optional)
# CHATBOT_PROVIDER=huggingface  # or 'openai'
# HUGGINGFACE_API_KEY=your-hf-key
# OPENAI_API_KEY=your-openai-key

# ============================================
# SECURITY
# ============================================
# Session configuration
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_HTTPONLY=true
SESSION_COOKIE_SAMESITE=Lax

# ============================================
# MONITORING (optional)
# ============================================
# LOG_LEVEL=INFO
# SENTRY_DSN=your-sentry-dsn
